# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# HubSpot private app token (no lo compartas)
HUBSPOT_TOKEN=
HUBSPOT_API_BASE=https://api.hubapi.com

# IA compatible con OpenAI (Groq por defecto)
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# Configuración
TIMEZONE=Europe/Madrid
POLL_INTERVAL=60
DAILY_SUMMARY_TIME=09:00
CURRENCY=EUR
DATABASE_PATH=./data/agent.db
LOG_LEVEL=INFO

# Confirmaciones: delete siempre; cambios de etapa/cierre de negocio siempre
CONFIRM_DELETES=true
CONFIRM_DEAL_STAGE_CHANGES=true

# Eventos de notificación separados por comas
EVENTS=contacts,companies,deals,tickets,tasks
